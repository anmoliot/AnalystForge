# =============================================================================
# AnalystForge configuration
# Copy to .env and fill in. `make env` generates a .env with secure random
# secrets on first run. NEVER commit .env.
#
# Required keys are marked [REQUIRED]. Optional keys degrade gracefully and
# the UI/API reports which providers are unavailable rather than inventing data.
# =============================================================================

# --- Runtime ---------------------------------------------------------------
# development | test | production. Production enforces Postgres, Redis,
# secure cookies, a non-wildcard CORS list and explicit encryption key.
ENVIRONMENT=development
DEBUG=false
# [REQUIRED] 32+ byte signing key. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# [REQUIRED IN PRODUCTION] Fernet key for encrypting TOTP secrets at rest.
# Dev derives one from SECRET_KEY. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# [REQUIRED] Async SQLAlchemy URL. Postgres is required in production.
# `make env` replaces the placeholder password with the generated one below.
DATABASE_URL=postgresql+asyncpg://analystforge:CHANGE_ME@localhost:5432/analystforge
# Docker Compose database credentials (generated by `make env`).
POSTGRES_USER=analystforge
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=analystforge
# [REQUIRED IN PRODUCTION] Redis for cache, rate limiting and the job queue.
# Leave empty in development to use the in-process cache/inline jobs (single node only).
# Docker Compose injects redis://redis:6379/0 automatically.
REDIS_URL=

# --- HTTP ------------------------------------------------------------------
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Public base URL used in emails and share links
PUBLIC_BASE_URL=http://localhost:8080

# --- Auth ------------------------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/oauth/google/callback

# --- Data providers (all optional; missing keys disable that adapter) ------
# SEC EDGAR requires a descriptive User-Agent with contact email per their
# fair-access policy. This is REQUIRED for fundamentals ingestion.
SEC_USER_AGENT=AnalystForge/0.1 (your-email@example.com)
# FRED CSV downloads work without a key; an API key enables the JSON API.
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
POLYGON_API_KEY=
FMP_API_KEY=
NEWSAPI_API_KEY=
# Yahoo and Stooq price adapters need no key and are marked unofficial.
# Order matters: comma-separated, primary first. Yahoo is the default because
# Stooq currently serves a browser challenge to non-browser clients.
PRICE_PROVIDERS=yahoo,stooq
# Public RSS feeds for the news adapter. SEC requires a descriptive
# SEC_USER_AGENT with contact details.
NEWS_RSS_FEEDS=https://www.sec.gov/news/pressreleases.rss,https://www.federalreserve.gov/feeds/press_all.xml,https://www.ecb.europa.eu/rss/press.html
# Seconds a failed provider is moved behind healthy alternatives.
PROVIDER_COOLDOWN_SECONDS=300
# Daily price history requested on first ingest.
PRICE_HISTORY_YEARS=10

# --- AI --------------------------------------------------------------------
# none | openai-compatible | anthropic
LLM_PROVIDER=openai-compatible     # none | openai-compatible | anthropic
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile  # configurable; verified at startup, see below
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_MAX_INPUT_TOKENS=5000
LLM_REQUESTS_PER_MINUTE=20
LLM_MAX_TOKENS=1200
ANTHROPIC_API_KEY=
# Local FinBERT sentiment (heavy dependency; disabled by default).
FINBERT_ENABLED=false
FINBERT_MODEL=ProsusAI/finbert
# Embeddings: local sentence-transformers model, or "lexical" for a
# deterministic offline fallback (lower quality, clearly reported in the UI).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Email -----------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AnalystForge <alerts@analystforge.local>
SMTP_TLS=false

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
LOG_JSON=true

# --- Product ---------------------------------------------------------------
DEMO_MODE=false
DATA_DIR=./var
MAX_UPLOAD_MB=25
UPLOAD_DIR=./var/uploads
HTTP_TIMEOUT_SECONDS=30
